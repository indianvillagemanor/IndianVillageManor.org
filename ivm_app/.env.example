# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# For containerized PostgreSQL (Docker Compose)
DATABASE_URL="postgresql://ivm_user:PASSWORD@postgres:5432/ivm_db"

# For external PostgreSQL (traditional setup)
# DATABASE_URL="postgresql://ivm_user:PASSWORD@localhost:5432/ivm_db"

# PostgreSQL container password (used by Docker Compose)
POSTGRES_PASSWORD=your_secure_password_here

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
EMAIL_SERVER=smtps://no-reply@indianvillagemanor.org:PASSWORD@smtp.forwardemail.net:465
EMAIL_FROM="Automated IVM Email<no-reply@indianvillagemanor.org>"
